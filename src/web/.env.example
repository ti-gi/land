# Copy this file to .env and fill in your key.
# Google Maps Platform API key with the "Map Tiles API" enabled (needs a billing account).
# Restrict it in Google Cloud Console: Application restrictions → HTTP referrers (e.g. http://localhost:3000/*),
# API restrictions → Map Tiles API, Maps JavaScript API, Places API (New), Geocoding API (address search). Without a key the map has a plain background.
GOOGLE_MAPS_API_KEY=

# Optional: port for the web server (default 3000)
# PORT=3000

# Optional: where the data is (defaults: ../../data/gup and ../../data/listings/listings-nekretnine.json, relative to this folder)
# GUP_DATA_DIR=../../data/gup
# LISTINGS_FILE=../../data/listings/listings-nekretnine.json
